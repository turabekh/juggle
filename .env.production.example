# Production deployment config for docker-compose.prod.yml.
# Copy to .env on the server and fill in real values. NEVER commit the filled .env (INV-9).
#
#   cp .env.production.example .env  &&  nano .env
#
# Product config (fees, TTLs, taxonomy, feature flags) lives in the DB / admin panel,
# not here. This file is deployment config only.

JUGGLE_ENVIRONMENT=production
JUGGLE_DEBUG=false

# --- Database -------------------------------------------------------------
# JUGGLE_DB_PASSWORD is used by the `db` container (POSTGRES_PASSWORD) AND must match
# the password embedded in JUGGLE_DATABASE_URL below. Host is `db` (the compose service).
# Generate one, e.g.:  openssl rand -hex 24
JUGGLE_DB_PASSWORD=CHANGE_ME_db_password
JUGGLE_DATABASE_URL=postgresql+psycopg://juggle:CHANGE_ME_db_password@db:5432/juggle

# --- Auth -----------------------------------------------------------------
# Generate a strong secret:  openssl rand -hex 48
JUGGLE_JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JUGGLE_ACCESS_TOKEN_TTL_MINUTES=30

# --- Site / domain --------------------------------------------------------
# DOMAIN drives Caddy: set it to your apex hostname for automatic HTTPS (needs an A record
# at the apex pointing at the VM and ports 80/443 open). Leave blank to serve plain HTTP on :80.
DOMAIN=kidspots.store
# Public origin used for absolute URLs (SEO sitemap, etc.). Use https:// once DOMAIN is set.
JUGGLE_PUBLIC_BASE_URL=https://kidspots.store
# The SPA is same-origin so CORS isn't strictly needed; list the site origin anyway.
JUGGLE_CORS_ORIGINS=["https://kidspots.store"]

# --- Stripe Connect -------------------------------------------------------
# Leave blank to run the in-memory FakeGateway (no real charges). Set live/test keys
# to enable the Stripe Payment Element. The webhook sink is:
#   POST https://<domain>/api/v1/booking/stripe/webhook
JUGGLE_STRIPE_SECRET_KEY=
JUGGLE_STRIPE_PUBLISHABLE_KEY=
JUGGLE_STRIPE_WEBHOOK_SECRET=

# --- Platform legal identity (provider commission tax invoices, ADR-0002) -
JUGGLE_PLATFORM_LEGAL_NAME=Juggle Marketplace Pty Ltd
JUGGLE_PLATFORM_ABN=

# --- Transactional email (SMTP: Postmark / Amazon SES / any provider) --------
# Leave blank to run the in-memory FakeEmailGateway (nothing is sent — dev default).
# Set the host + from-address to send real mail (booking confirmations, waitlist
# offers, and — once you turn its flag on in admin — party invites/reveals).
# Postmark SMTP: host smtp.postmarkapp.com:587, username & password = your Server API token.
# Amazon SES SMTP: host email-smtp.<region>.amazonaws.com:587 + SES SMTP credentials.
JUGGLE_EMAIL_SMTP_HOST=
JUGGLE_EMAIL_SMTP_PORT=587
JUGGLE_EMAIL_SMTP_USERNAME=
JUGGLE_EMAIL_SMTP_PASSWORD=
JUGGLE_EMAIL_SMTP_STARTTLS=true
JUGGLE_EMAIL_FROM_ADDRESS=
JUGGLE_EMAIL_FROM_NAME=Kidspots
