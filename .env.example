# Copy to .env and adjust. All backend vars are prefixed JUGGLE_.
# Runtime *product* config (fees, TTLs, taxonomy) lives in the DB / admin panel,
# not here — this file is deployment config only.

JUGGLE_ENVIRONMENT=local
JUGGLE_DEBUG=true
JUGGLE_DATABASE_URL=postgresql+psycopg://juggle:juggle@localhost:5433/juggle

# Auth — generate a strong secret for anything non-local.
JUGGLE_JWT_SECRET=dev-insecure-change-me
JUGGLE_ACCESS_TOKEN_TTL_MINUTES=15
JUGGLE_REFRESH_TOKEN_TTL_DAYS=30

# --- SMS one-time-code sign-in (Twilio) ---
# Leave blank in local dev (codes print to the API console via the fake gateway).
# Set all three to enable real SMS; outside local dev, /identity/otp/* is
# fail-closed and the login "Phone" tab is hidden until these are set.
JUGGLE_TWILIO_ACCOUNT_SID=
JUGGLE_TWILIO_AUTH_TOKEN=
JUGGLE_TWILIO_FROM_NUMBER=      # your Twilio number in E.164, e.g. +61480000000

# Comma/JSON list of allowed CORS origins (Quasar dev server default below).
JUGGLE_CORS_ORIGINS=["http://localhost:9000"]

# --- Stripe Connect (test mode) ---
# Leave blank to use the in-memory FakeGateway (local dev + CI need no Stripe account).
# App config is JUGGLE_-prefixed; the Stripe CLI separately reads STRIPE_API_KEY.
JUGGLE_STRIPE_SECRET_KEY=
JUGGLE_STRIPE_PUBLISHABLE_KEY=
JUGGLE_STRIPE_WEBHOOK_SECRET=
# For local webhook forwarding: stripe listen --forward-to localhost:8000/api/v1/booking/stripe/webhook
# STRIPE_API_KEY=sk_test_...   # used by the Stripe CLI, not the app

# Platform legal identity — the supplier on provider commission tax invoices (ADR-0002).
# Set the real registered name + ABN before charging in production.
JUGGLE_PLATFORM_LEGAL_NAME=Juggle Marketplace Pty Ltd
JUGGLE_PLATFORM_ABN=

# --- AI holiday planner (Anthropic) ---
# Leave blank to use the deterministic rule-based planner (no LLM, no cost).
# Set the key to have Claude compose itineraries; model is optional.
JUGGLE_ANTHROPIC_API_KEY=
JUGGLE_ANTHROPIC_MODEL=claude-opus-4-8

# --- Other third-party (fill in as milestones land) ---
# POSTMARK_SERVER_TOKEN=
