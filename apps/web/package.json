{
  "name": "juggle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juggle — parent-facing marketplace PWA (Quasar + Vue 3)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ssr:dev": "node server.mjs",
    "build:client": "QUASAR_SSR=client vite build --ssrManifest --outDir dist/client",
    "build:server": "QUASAR_SSR=server vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:ssr": "vue-tsc --noEmit && npm run build:client && npm run build:server",
    "ssr:serve": "NODE_ENV=production node server.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "@stripe/stripe-js": "^4.10.0",
    "axios": "^1.7.7",
    "pinia": "^2.2.4",
    "quasar": "^2.17.1",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@quasar/vite-plugin": "^1.8.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.80.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
